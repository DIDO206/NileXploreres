// ربط أحداث تغيير القيمة بدالة التحديث
yearSlider.onChange(updateDashboard); 
scarcitySlider.onChange(updateDashboard);
pollutionSlider.onChange(updateDashboard);
waterScarcityCheck.onChange(updateDashboard);
vegetationCheck.onChange(updateDashboard);
tempCheck.onChange(updateDashboard);
pollutionCheck.onChange(updateDashboard);

// ربط أزرار + و - بالوظائف الجديدة
incrementButton.onClick(incrementYear);
decrementButton.onClick(decrementYear);

// ربط زر الرسوم المتحركة
animateButton.onClick(createAnimation);

// عرض الخريطة عند التشغيل
updateDashboard();
