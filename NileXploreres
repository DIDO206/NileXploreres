// =================================================================================
// 5. دالة تحديث لوحة التحكم (Map Update Function) - تم تحديثها بالكامل
// =================================================================================

function updateDashboard() {
  // مسح جميع الطبقات والمفاتيح لضمان التحديث الصحيح
  Map.layers().reset();
  
  // إزالة مفاتيح الخرائط السابقة فقط
  Map.widgets().forEach(function(w) {
    if (w && w.style) {
      Map.remove(w);
    }
  });

  // جلب قيمة السنة الحالية
  var year = yearSlider.getValue(); 
  
  // التأكد من جلب الصورة السنوية الصحيحة حسب السنة المختارة
  var ndviImg = yearlyNDVI.filter(ee.Filter.eq('year', year)).first();
  var waterProxyImg = yearlyWaterProxy.filter(ee.Filter.eq('year', year)).first();
  var lstImg  = yearlyLST.filter(ee.Filter.eq('year', year)).first();
  
  // تحديث تسميات الـ Sliders
  scarcityLabel.setValue('عتبة نقص المياه (أقل من: ' + scarcitySlider.getValue().toFixed(2) + '):');
  pollutionLabel.setValue('عتبة التلوث التقديري (أقل من: ' + pollutionSlider.getValue().toFixed(2) + '):');
  
  // تحديث تسمية السنة المعروضة
  yearLabel.setValue('اختر السنة: ' + year); 

  // 1. الغطاء النباتي (NDVI) - 🟤🟡🟢🟢
  var ndviViz = {min: 0.05, max: 0.8, palette: ['brown', 'yellow', 'green', 'darkgreen'], opacity: 0.7};
  if(vegetationCheck.getValue() && ndviImg) {
      Map.addLayer(ndviImg.clip(aoi), ndviViz, 'الغطاء النباتي (NDVI)', true);
      addAdvancedLegend(
        'مؤشر الغطاء النباتي', 
        ndviViz.palette, 
        ndviViz.min, 
        ndviViz.max, 
        '(NDVI)', 
        'bottom-right',
        'يقيس كثافة النباتات: البني (قاحل) ← الأخضر (كثيف)'
      );
  }

  // 2. درجة الحرارة (LST) - 🔵🟢🟡🔴
  var tempViz = {min: 20, max: 45, palette: ['blue', 'cyan', 'yellow', 'red'], opacity: 0.6};
  if(tempCheck.getValue() && lstImg) {
      Map.addLayer(lstImg.clip(aoi), tempViz, 'درجة الحرارة (LST)', false);
      addAdvancedLegend(
        'درجة حرارة السطح', 
        tempViz.palette, 
        tempViz.min, 
        tempViz.max, 
        '(درجة مئوية)', 
        'bottom-left',
        'درجة حرارة الأرض: الأزرق (بارد) ← الأحمر (حار)'
      );
  }

  // 3. نقص المياه (Water Scarcity) - 🔴
  if(waterScarcityCheck.getValue() && waterProxyImg) {
    var scarcityThreshold = scarcitySlider.getValue();
    var waterScarcity = waterProxyImg.lt(scarcityThreshold).selfMask().clip(aoi);
    var scarcityViz = {palette: ['#FF0000'], opacity: 0.8}; 
    Map.addLayer(waterScarcity, scarcityViz, 'نقص المياه (Scarcity)', false);
    
    // مفتاح الألوان لنقص المياه (أحمر)
    addBinaryLegend(
      '🚨 نقص المياه', 
      '#FF0000', 
      'مناطق نقص المياه', 
      'top-left',
      'اللون الأحمر يظهر المناطق التي تعاني من شح في المياه بناءً على مؤشر EVI المنخفض'
    );
  }
  
  // 4. تلوث المياه (Pollution Proxy) - 🟣
  if(pollutionCheck.getValue() && waterProxyImg) {
    var pollutionThreshold = pollutionSlider.getValue();
    var waterPollution = waterProxyImg.lt(pollutionThreshold).selfMask().clip(aoi);
    var pollutionViz = {palette: ['#800080'], opacity: 0.8}; 
    Map.addLayer(waterPollution, pollutionViz, 'تلوث المياه (Pollution)', false);
    
    // مفتاح الألوان لتلوث المياه (بنفسجي)
    addBinaryLegend(
      '⚠ تلوث المياه', 
      '#800080', 
      'مناطق التلوث المائي', 
      'top-right',
      'اللون البنفسجي يظهر المناطق المحتملة لتلوث المياه بناءً على مؤشر EVI المنخفض'
    );
  }

  // إضافة حدود المنطقة
  Map.addLayer(egypt, {color: 'red', fillColor: '00000000'}, "حدود مصر", false);
  
  // إضافة مفتاح إضافي يشرح كل الألوان
  var generalLegend = ui.Panel({
    widgets: [
      ui.Label('🗝 شرح الألوان في الخريطة:', {
        fontWeight: 'bold', 
        fontSize: '16px', 
        margin: '0 0 8px 0',
        color: '#2c3e50'
      }),
      ui.Label('🟢 الأخضر: نباتات كثيفة', {margin: '2px 0', fontSize: '13px'}),
      ui.Label('🟡 الأصفر: نباتات متوسطة', {margin: '2px 0', fontSize: '13px'}),
      ui.Label('🟤 البني: مناطق قاحلة', {margin: '2px 0', fontSize: '13px'}),
      ui.Label('🔵 الأزرق: مناطق باردة', {margin: '2px 0', fontSize: '13px'}),
      ui.Label('🔴 الأحمر: مناطق حارة', {margin: '2px 0', fontSize: '13px'}),
      ui.Label('🚨 الأحمر الفاتح: نقص مياه', {margin: '2px 0', fontSize: '13px', color: '#FF0000'}),
      ui.Label('🟣 البنفسجي: تلوث مياه', {margin: '2px 0', fontSize: '13px', color: '#800080'})
    ],
    style: {
      position: 'top-right',
      padding: '15px',
      backgroundColor: 'white',
      border: '2px solid #333',
      borderRadius: '8px',
      margin: '0 0 0 400px' // لضمان عدم التداخل مع المفاتيح الأخرى
    }
  });
  
  Map.add(generalLegend);
  
  Map.centerObject(aoi, 6);
}

// ---------------------------
// دالة لزيادة السنة
var incrementYear = function() {
  var currentYear = yearSlider.getValue();
  if (currentYear < END_YEAR) {
    yearSlider.setValue(currentYear + 1);
    updateDashboard();
  }
};

// دالة لإنقاص السنة
var decrementYear = function() {
  var currentYear = yearSlider.getValue();
  if (currentYear > START_YEAR) {
    yearSlider.setValue(currentYear - 1);
    updateDashboard();
  }
};

// ---------------------------
// 6. وظيفة الرسوم المتحركة (Animation Function)
// ---------------------------

var createAnimation = function() {
  
  var ndviViz = {min: 0.05, max: 0.8, palette: ['brown', 'yellow', 'green', 'darkgreen'], opacity: 0.7};
  
  var yearlyNDVI_vis = yearlyNDVI.map(function(image) {
    var rgb = image.visualize(ndviViz).clip(aoi); 
    return rgb.copyProperties(image, ['system:time_start', 'year']);
  });
  
  // تصدير الفيديو إلى Google Drive
  Export.video.toDrive({
    collection: yearlyNDVI_vis,
    description: 'Nile_NDVI_Animation_' + START_YEAR + 'to' + END_YEAR,
    fileNamePrefix: 'NDVI_Animation',
    framesPerSecond: 5,
    region: aoi,
    scale: 1000,
    maxPixels: 1e10
  });
  
  // رسالة تأكيد في الكونسول
  print('تم إطلاق مهمة تصدير الرسوم المتحركة (GIF) إلى Google Drive. تحقق من علامة التبويب "Tasks".');
  Map.add(ui.Label('✅ تم إطلاق مهمة التصدير إلى Google Drive. (تحقق من علامة التبويب "Tasks")', {color: 'green'}));
};

