// تحديد المنطقة: حدود مصر
var egypt = ee.FeatureCollection("FAO/GAUL/2015/level0")
              .filter(ee.Filter.eq("ADM0_NAME", "Egypt"));
var aoi = egypt.geometry().bounds(); 

var START_YEAR = 2000;
var END_YEAR = 2025;
var years = ee.List.sequence(START_YEAR, END_YEAR);

// =================================================================================
// 2. الحصول على البيانات ومعالجتها (المقاييس الأربعة)
// =================================================================================

// 2.1. الغطاء النباتي (NDVI) - من MODIS/MOD13A2
var ndviCollection = ee.ImageCollection("MODIS/061/MOD13A2")
                          .filterBounds(aoi)
                          .filterDate("2000-01-01", "2025-12-31")
                          .select('NDVI')
                          .map(function(img) {
                            return img.divide(10000).rename('NDVI').copyProperties(img, ['system:time_start']);
                          });

// 2.2. مؤشر المياه (EVI كبديل لنقص المياه والتلوث) - من MODIS/MOD13A2
var waterProxyCollection = ee.ImageCollection("MODIS/061/MOD13A2")
                          .filterBounds(aoi)
                          .filterDate("2000-01-01", "2025-12-31")
                          .select('EVI')
                          .map(function(img) {
                            return img.divide(10000).rename('Water_Proxy').copyProperties(img, ['system:time_start']);
                          });

// 2.3. درجة الحرارة (LST) - من MODIS/MOD11A2
var lstCollection = ee.ImageCollection("MODIS/061/MOD11A2")
                  .filterBounds(aoi)
                  .filterDate("2000-01-01", "2025-12-31")
                  .map(function(img) {
                    var lst = img.select('LST_Day_1km')
                               .multiply(0.02)
                               .subtract(273.15) // تحويل كلفن إلى سيليزيوس
                               .rename('LST');
                    return lst.copyProperties(img, ['system:time_start']);
                  });

// 2.4. دالة المتوسط السنوي
function yearlyComposite(collection, year) {
  var start = ee.Date.fromYMD(ee.Number(year), 1, 1);
  var end = start.advance(1, 'year');
  return collection.filterDate(start, end).median().set('year', year);
}

// إنشاء المجموعات السنوية
var yearlyNDVI = ee.ImageCollection.fromImages(
  years.map(function(y){ return yearlyComposite(ndviCollection, y); })
);

var yearlyWaterProxy = ee.ImageCollection.fromImages(
  years.map(function(y){ return yearlyComposite(waterProxyCollection, y); })
);

var yearlyLST = ee.ImageCollection.fromImages(
  years.map(function(y){ return yearlyComposite(lstCollection, y); })
);

