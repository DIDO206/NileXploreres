// دالة متقدمة لإضافة مفتاح الألوان للتدرجات (NDVI و LST)
var addAdvancedLegend = function(title, palette, min, max, units, position, description) {
  var legendPanel = ui.Panel({
    style: {
      position: position || 'bottom-left',
      padding: '12px',
      backgroundColor: 'white',
      border: '2px solid #333',
      borderRadius: '8px',
      fontSize: '14px',
      fontWeight: 'bold'
    }
  });

  // عنوان المفتاح
  var legendTitle = ui.Label({
    value: '🗺 ' + title,
    style: {fontWeight: 'bold', fontSize: '16px', margin: '0 0 8px 0', color: '#2c3e50'}
  });
  legendPanel.add(legendTitle);

  // شرح المؤشر
  if (description) {
    var descLabel = ui.Label({
      value: description,
      style: {fontSize: '12px', margin: '0 0 10px 0', color: '#7f8c8d'}
    });
    legendPanel.add(descLabel);
  }

  // إنشاء شريط التدرج اللوني
  var colorBar = ui.Thumbnail({
    image: ee.Image.pixelLonLat().select(0).visualize({
      min: 0,
      max: 100,
      palette: palette,
    }),
    params: {bbox:'0,0,10,10', dimensions:'150x20', format:'png'},
    style: {stretch: 'horizontal', margin: '0px 8px', height: '20px'}
  });
  legendPanel.add(colorBar);

  // تسميات القيم (Min, Mid, Max)
  var labels = ui.Panel({
    widgets: [
      ui.Label('منخفض ←', {margin: '4px 8px 0 0', fontSize: '11px', fontWeight: 'bold'}),
      ui.Label('→ مرتفع', {margin: '4px 0 0 8px', fontSize: '11px', fontWeight: 'bold'})
    ],
    layout: ui.Panel.Layout.flow('horizontal')
  });
  legendPanel.add(labels);

  // القيم الرقمية
  var values = ui.Panel({
    widgets: [
      ui.Label(min.toFixed(1), {margin: '2px 8px 0 0', fontSize: '11px'}),
      ui.Label(((min + max) / 2).toFixed(1), {margin: '2px 0', textAlign: 'center', stretch: 'horizontal', fontSize: '11px'}),
      ui.Label(max.toFixed(1), {margin: '2px 0 0 8px', fontSize: '11px'})
    ],
    layout: ui.Panel.Layout.flow('horizontal')
  });
  legendPanel.add(values);

  // الوحدة
  if (units) {
    var unitLabel = ui.Label({
      value: 'الوحدة: ' + units,
      style: {fontSize: '11px', margin: '4px 0 0 0', color: '#7f8c8d', fontStyle: 'italic'}
    });
    legendPanel.add(unitLabel);
  }

  Map.add(legendPanel);
};

